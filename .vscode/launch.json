{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend (local)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--manifest-path", "backend/Cargo.toml", "--bin", "server"],
                "filter": { "name": "server", "kind": "bin" }
            },
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env"
        },
        {
            "name": "Push Worker (local)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--manifest-path", "backend/Cargo.toml", "--bin", "pushworker"],
                "filter": { "name": "pushworker", "kind": "bin" }
            },
            "cwd": "${workspaceFolder}/backend",
            "envFile": "${workspaceFolder}/backend/.env"
        }
    ],
    "compounds": [
        {
            "name": "All Services",
            "configurations": ["Backend (local)", "Push Worker (local)"]
        }
    ]
}
