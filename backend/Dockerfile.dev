# Development image: rebuilds and restarts the API server whenever the source changes.
ARG RUST_VERSION=1
FROM rust:${RUST_VERSION}-bookworm

RUN cargo install cargo-watch --locked

WORKDIR /app

# Source is bind-mounted by docker-compose; the build cache lives in named volumes.
EXPOSE 8000

CMD ["cargo", "watch", "--poll", "-w", "crates", "-w", "Cargo.toml", "-x", "run --bin server"]
