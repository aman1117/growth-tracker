# Development image: rebuilds and restarts the push worker whenever the source changes.
ARG RUST_VERSION=1
FROM rust:${RUST_VERSION}-bookworm

RUN cargo install cargo-watch --locked

WORKDIR /app

EXPOSE 8001

CMD ["cargo", "watch", "--poll", "-w", "crates", "-w", "Cargo.toml", "-x", "run --bin pushworker"]
